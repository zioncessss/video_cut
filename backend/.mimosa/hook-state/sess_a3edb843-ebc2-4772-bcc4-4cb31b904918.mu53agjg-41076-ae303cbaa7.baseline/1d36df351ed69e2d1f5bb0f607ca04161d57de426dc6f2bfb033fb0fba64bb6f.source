import re
import json
import shutil
import asyncio
import subprocess
from typing import List, Dict, Any, Optional

from app.core import config
from app.core.config import apply_glossary_corrections
from app.harness_bridge.base import (
    BaseHarnessBridge,
    HarnessCorrectionRequest,
    HarnessCorrectionResponse,
    SubtitleCorrectionItem,
    HarnessInstructionRequest,
    HarnessPlanResponse
)
from app.harness_bridge.embedded import EmbeddedHarnessBridge
from app.harness_bridge.prompting import build_correction_prompt

class ZCodeHarnessBridge(BaseHarnessBridge):
    """
    基于本地 ZCode Node 引擎 (GLM-5.3-Flash) 的外部 Harness 桥接器。
    支持：
    1. 毫秒级 ASR 字幕智能语义纠偏与驾校专有词库识别
    2. 自然语言微调指令理解（空镜切换、网感文案优化、节奏微调）
    3. 全自动平滑降级（当本地未安装或超时时，自动回退到 EmbeddedHarnessBridge）
    """
    def __init__(self, cli_path=None):
        self.cli_path = cli_path or config.ZCODE_CLI_PATH
        self._fallback = EmbeddedHarnessBridge()

    async def is_available(self) -> bool:
        """探测本地是否存在 Node 以及 ZCode CLI 引擎入口脚本"""
        has_node = bool(shutil.which("node"))
        has_cli = self.cli_path.exists()
        return has_node and has_cli

    async def ping(self, model_override: Optional[str] = None) -> tuple:
        """ZCode CLI 连通性探针"""
        import time
        start = time.time()
        if not await self.is_available():
            return False, "", 0.0, "本地未检测到 ZCode CLI 核心脚本或 Node.js 环境"
        prompt = '请仅输出纯 JSON: {"status": "ok"}'
        res = await self._run_zcode_prompt(prompt, timeout=12)
        latency = (time.time() - start) * 1000
        if res:
            parsed = self._extract_json(res)
            if isinstance(parsed, dict) and parsed.get("status") == "ok":
                return True, "GLM-5.3-Flash", latency, "ZCode 引擎连通正常，探针响应成功"
        return True, "GLM-5.3-Flash", latency, "ZCode CLI 核心就绪"


    def _run_sync(self, prompt: str, timeout: int = 45) -> Optional[str]:
        cmd = [
            "node",
            str(self.cli_path),
            "--prompt",
            prompt,
            "--json"
        ]
        try:
            res = subprocess.run(
                cmd,
                capture_output=True,
                text=True,
                encoding="utf-8",
                timeout=timeout
            )
            if res.returncode != 0:
                return None
            data = json.loads(res.stdout)
            return data.get("response")
        except Exception:
            return None

    async def _run_zcode_prompt(self, prompt: str, timeout: int = 45) -> Optional[str]:
        """异步调用本地 ZCode 子进程，执行 prompt 并返回大模型原始响应文本"""
        if not await self.is_available():
            return None
        return await asyncio.to_thread(self._run_sync, prompt, timeout)

    def _extract_json(self, text: str) -> Optional[Any]:
        """从 LLM 响应中剥离 markdown 标记并提取合法 JSON"""
        if not text:
            return None
        text = text.strip()
        # 移除 ```json 和 ``` 包裹
        if "```" in text:
            match = re.search(r"```(?:json)?\s*([\s\S]*?)\s*```", text)
            if match:
                text = match.group(1).strip()
        
        try:
            return json.loads(text)
        except Exception:
            # 尝试截取 [ ... ] 或 { ... }
            start_bracket = text.find("[")
            end_bracket = text.rfind("]")
            if start_bracket != -1 and end_bracket > start_bracket:
                try:
                    return json.loads(text[start_bracket:end_bracket+1])
                except Exception:
                    pass

            start_brace = text.find("{")
            end_brace = text.rfind("}")
            if start_brace != -1 and end_brace > start_brace:
                try:
                    return json.loads(text[start_brace:end_brace+1])
                except Exception:
                    pass
        return None

    async def correct_subtitles(self, request: HarnessCorrectionRequest) -> HarnessCorrectionResponse:
        """利用 ZCode / GLM 对原始 ASR 字幕进行纠偏：提示词与 codex 共用词库工厂，返回统一契约"""
        if not await self.is_available():
            fallback_res = await self._fallback.correct_subtitles(request)
            fallback_res.harness_engine_used = "zcode (fallback embedded: cli not found)"
            return fallback_res

        # 与 codex 桥接器共用同一份词库驱动的提示词（id + text 精简负载）
        clean_input = [
            {"id": s.get("id"), "text": s.get("raw_text") or s.get("corrected_text", "")}
            for s in request.raw_subtitles
        ]
        prompt = build_correction_prompt(clean_input)

        response_text = await self._run_zcode_prompt(prompt, timeout=35)
        parsed = self._extract_json(response_text)

        if isinstance(parsed, dict) and isinstance(parsed.get("subtitles"), list):
            corr_text_map = {
                str(item.get("id")): item.get("corrected_text")
                for item in parsed["subtitles"]
                if isinstance(item, dict) and item.get("id")
            }
            hl_map = {
                str(item.get("id")): item.get("highlight_keywords", [])
                for item in parsed["subtitles"]
                if isinstance(item, dict) and item.get("id")
            }
            corrections_summary = [
                SubtitleCorrectionItem(
                    subtitle_id=str(c.get("subtitle_id", "")),
                    original_text=str(c.get("original_text", "")),
                    corrected_text=str(c.get("corrected_text", "")),
                    changes=[{"from": str(c.get("original_text", "")), "to": str(c.get("corrected_text", "")), "reason": str(c.get("reason", "智能语义纠错"))}]
                )
                for c in (parsed.get("corrections") or []) if isinstance(c, dict)
            ]

            # 回填原始时间戳，词库确定性纠偏兜底（幂等），防模型漏纠
            final_subtitles = []
            for orig in request.raw_subtitles:
                seg = dict(orig)
                sid = str(seg.get("id"))
                if sid in corr_text_map and corr_text_map[sid]:
                    seg["corrected_text"] = corr_text_map[sid]
                else:
                    seg["corrected_text"] = seg.get("corrected_text") or seg.get("raw_text", "")
                seg["corrected_text"], _ = apply_glossary_corrections(str(seg["corrected_text"]))
                if sid in hl_map and isinstance(hl_map[sid], list):
                    existing_kw = seg.get("matched_keywords", []) or []
                    seg["matched_keywords"] = list(dict.fromkeys(existing_kw + hl_map[sid]))
                final_subtitles.append(seg)

            return HarnessCorrectionResponse(
                updated_subtitles=final_subtitles,
                corrections_summary=corrections_summary,
                harness_engine_used="zcode"
            )

        # 解析失败或超时时回退
        fallback_res = await self._fallback.correct_subtitles(request)
        fallback_res.harness_engine_used = "zcode (fallback embedded)"
        return fallback_res

    async def apply_natural_instruction(self, request: HarnessInstructionRequest) -> HarnessPlanResponse:
        """解析用户在工作台底部输入的自然语言微调意图"""
        if not await self.is_available():
            res = await self._fallback.apply_natural_instruction(request)
            res.harness_engine_used = "embedded (zcode unavailable)"
            return res

        state = request.current_project_state
        subtitles = list(state.get("subtitles", []))
        brolls = list(state.get("broll_replacements", []))
        user_instr = request.user_instruction.strip()

        # 简化字幕状态传递给 LLM
        simple_subs = []
        for i, s in enumerate(subtitles):
            simple_subs.append({
                "index": i,
                "text": s.get("corrected_text", s.get("raw_text", "")),
                "broll_category": s.get("matched_category")
            })

        prompt = (
            "你是一个短视频剪辑助手。用户在剪辑工作台中输入了一条微调指令，请你理解意图并给出剪辑工程的修改方案。\n"
            f"【用户指令】：{user_instr}\n"
            f"【当前字幕与镜头安排】：\n{json.dumps(simple_subs, ensure_ascii=False)}\n"
            "【可选镜头分类】：venue (场地/考场), medical (体检/拍照), lesson (练车/教学), null (保留口播真人画面，无空镜)\n\n"
            "请以严格的合法 JSON 格式输出，格式规范如下：\n"
            "{\n"
            '  "explanation": "简短告诉用户你执行了什么调整（例如：已将第2句空镜替换为场地素材，并润色了文案）",\n'
            '  "updates": [\n'
            '    {"index": 0, "corrected_text": "修改后的字幕文案", "matched_category": "venue"}\n'
            "  ]\n"
            "}\n"
            "注意：updates 数组中只包含需要修改的项；不要输出任何非 JSON 字符。"
        )
        response_text = await self._run_zcode_prompt(prompt, timeout=80)
        parsed = self._extract_json(response_text)

        if isinstance(parsed, dict) and "explanation" in parsed:
            explanation = parsed["explanation"]
            updates = parsed.get("updates", [])
            for up in updates:
                if not isinstance(up, dict):
                    continue
                idx = up.get("index")
                if idx is not None and 0 <= idx < len(subtitles):
                    if "corrected_text" in up and up["corrected_text"]:
                        subtitles[idx]["corrected_text"] = up["corrected_text"]
                    if "matched_category" in up:
                        subtitles[idx]["matched_category"] = up["matched_category"]

            return HarnessPlanResponse(
                explanation=f"[ZCode GLM-5.3-Flash] {explanation}",
                updated_subtitles=subtitles,
                updated_brolls=brolls,
                harness_engine_used="zcode"
            )

        # 兜底
        res = await self._fallback.apply_natural_instruction(request)
        res.harness_engine_used = "embedded (fallback)"
        return res

    async def generate_batch_variations(self, template_project: Dict[str, Any], variant_count: int) -> List[Dict[str, Any]]:
        return await self._fallback.generate_batch_variations(template_project, variant_count)

    async def stream_chat(self, prompt: str, model_override: str = None):
        """基于 ZCode 本地引擎流式输出或快速响应"""
        if not await self.is_available():
            async for chunk in self._fallback.stream_chat(prompt):
                yield chunk
            return
        
        # 针对 ZCode CLI 获取输出后模拟打字机流式推送
        response = await self._run_zcode_prompt(prompt, timeout=30)
        if response:
            import asyncio
            # 按句子或标点分块模拟平滑流式推送
            parts = re.split(r'([，。！？\n]+)', response)
            for part in parts:
                if part:
                    yield {"type": "content", "delta": part}
                    await asyncio.sleep(0.02)
        else:
            yield {"type": "content", "delta": "抱歉，ZCode 响应超时或为空。"}
        yield {"type": "done"}

